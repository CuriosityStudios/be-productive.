<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Be Productive</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background: #08080f;
    color: white;
    font-family: Arial, sans-serif;
}

:root {
    --purple: #8755ff;
    --dark: #101019;
    --card: #191923;
    --muted: #aaaab8;
}

button {
    cursor: pointer;
    border: none;
    font-size: 14px;
}

.app {
    max-width: 430px;
    min-height: 100vh;
    margin: auto;
    background: #0c0c14;
    position: relative;
    padding-bottom: 85px;
}

header {
    padding: 25px 22px;
}

.screen {
    display: none;
    padding: 10px 20px;
}

.screen.active {
    display: block;
}

h1 {
    font-size: 27px;
    margin-bottom: 8px;
}

h2 {
    font-size: 19px;
    margin-bottom: 15px;
}

p {
    color: var(--muted);
    line-height: 1.5;
}

.card {
    background: var(--card);
    border-radius: 20px;
    padding: 20px;
    margin: 15px 0;
}

.primary {
    background: linear-gradient(110deg,#7850ff,#a16bff);
    color: #080810;
    font-weight: bold;
    border-radius: 30px;
    padding: 16px;
    width: 100%;
}

.primary:active {
    transform: scale(.98);
}

.purple {
    color: var(--purple);
}

/* Welcome */

#welcome {
    min-height: 90vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
    background:
    radial-gradient(ellipse at 80% 10%,#28164d 0%,transparent 45%),
    #0c0c14;
}

.logo {
    font-size: 75px;
    color: var(--purple);
    font-weight: bold;
    margin-bottom: 20px;
}

.brand {
    font-size: 35px;
    font-weight: bold;
    margin-bottom: 20px;
}

.brand span {
    color: var(--purple);
}

/* Home */

.progress {
    display: flex;
    align-items: center;
    gap: 25px;
}

.circle {
    width: 105px;
    height: 105px;
    border-radius: 50%;
    border: 9px solid #4c70ff;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 24px;
    font-weight: bold;
}

.goal {
    margin: 12px 0;
    font-size: 14px;
}

.goal input {
    accent-color: var(--purple);
    margin-right: 8px;
}

.streak {
    background: linear-gradient(110deg,#6426c9,#913dff);
    padding: 20px;
    border-radius: 18px;
    margin: 18px 0;
}

.grid {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 9px;
}

.grid-item {
    background: var(--card);
    padding: 15px 5px;
    border-radius: 15px;
    text-align: center;
    font-size: 12px;
}

.grid-item div {
    font-size: 24px;
    margin-bottom: 8px;
}

.schedule {
    display: flex;
    justify-content: space-between;
    background: var(--card);
    padding: 17px;
    border-radius: 15px;
    margin-top: 10px;
}

/* Learning */

.banner {
    background: linear-gradient(130deg,#33166c,#7540db);
    border-radius: 20px;
    padding: 25px;
    margin: 15px 0;
}

.list-item {
    background: var(--card);
    padding: 17px;
    margin: 10px 0;
    border-radius: 16px;
    display: flex;
    gap: 15px;
    align-items: center;
}

.icon {
    font-size: 28px;
}

/* Workout */

.workout-hero {
    text-align: center;
    padding: 30px 10px;
}

.dumbbell {
    font-size: 65px;
    color: var(--purple);
    margin-bottom: 15px;
}

.workout-card {
    background: var(--card);
    padding: 18px;
    border-radius: 17px;
    margin: 10px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

/* Navigation */

nav {
    position: fixed;
    bottom: 0;
    width: 100%;
    max-width: 430px;
    background: #15151f;
    display: flex;
    justify-content: space-around;
    padding: 15px 5px;
    border-top: 1px solid #292936;
}

nav button {
    background: transparent;
    color: #9999aa;
    display: flex;
    flex-direction: column;
    gap: 5px;
    align-items: center;
    font-size: 11px;
}

nav button span {
    font-size: 21px;
}

nav button.selected {
    color: var(--purple);
}

@media(min-width:600px) {
    body {
        padding: 20px 0;
    }
    .app {
        border: 1px solid #333;
        border-radius: 25px;
        overflow: hidden;
    }
    nav {
        left: 50%;
        transform: translateX(-50%);
    }
}
</style>
</head>

<body>

<div class="app">

<!-- WELCOME -->

<section id="welcome" class="screen active">

<div class="logo">↗B</div>

<div class="brand">
Be <span>Productive</span>
</div>

<p>Plan. Learn. Improve.</p>
<p>Become the best version of you.</p>

<br><br>

<button class="primary" onclick="showScreen('home')">
Get Started →
</button>

</section>


<!-- HOME -->

<section id="home" class="screen">

<header>
<p>Good Morning,</p>
<h1>Achiever! 👑</h1>
<p>Small steps. Big changes.</p>
</header>

<h2>Today's Progress</h2>

<div class="card progress">

<div class="circle" id="percentage">0%</div>

<div>
<label class="goal">
<input type="checkbox" onchange="updateProgress()">
Study Goal
</label>

<label class="goal">
<input type="checkbox" onchange="updateProgress()">
Workout
</label>

<label class="goal">
<input type="checkbox" onchange="updateProgress()">
Learn a Skill
</label>

<label class="goal">
<input type="checkbox" onchange="updateProgress()">
Read 10 Pages
</label>
</div>

</div>

<div class="streak">
<h2>🏆 Your Journey</h2>
<p>Every day is an opportunity to improve.</p>
</div>

<h2>Quick Access</h2>

<div class="grid">

<div class="grid-item" onclick="showScreen('workout')">
<div>🏋️</div>Workout
</div>

<div class="grid-item" onclick="showScreen('home')">
<div>🎓</div>Study
</div>

<div class="grid-item" onclick="showScreen('learn')">
<div>📚</div>Learn
</div>

<div class="grid-item">
<div>🌿</div>Wellness
</div>

</div>

<br>

<h2>Your Schedule</h2>

<div class="schedule">
<span>📅 Study Session</span>
<span class="purple">10:00 AM</span>
</div>

<div class="schedule">
<span>🏋️ Workout</span>
<span class="purple">5:00 PM</span>
</div>

</section>


<!-- LEARNING -->

<section id="learn" class="screen">

<header>
<h1>Learn 📚</h1>
<p>Build yourself, one skill at a time.</p>
</header>

<div class="banner">
<h2>Build New Skills</h2>
<p>Learn anything, at your own pace.</p>
<br>
<button class="primary" onclick="alert('Explore your learning journey!')">
Explore Courses →
</button>
</div>

<h2>Popular Skills</h2>

<div class="list-item">
<div class="icon">💻</div>
<div>
<strong>Python Programming</strong>
<p>Beginner · 6 hours</p>
</div>
</div>

<div class="list-item">
<div class="icon">📈</div>
<div>
<strong>Personal Finance</strong>
<p>Beginner · 4 hours</p>
</div>
</div>

<div class="list-item">
<div class="icon">👥</div>
<div>
<strong>Communication Skills</strong>
<p>Beginner · 3 hours</p>
</div>
</div>

<div class="list-item">
<div class="icon">🧠</div>
<div>
<strong>Productivity Mastery</strong>
<p>Beginner · 2 hours</p>
</div>
</div>

</section>


<!-- WORKOUT -->

<section id="workout" class="screen">

<header>
<h1>Workout 🏋️</h1>
<p>Your personal fitness companion.</p>
</header>

<div class="workout-hero">

<div class="dumbbell">🏋️</div>

<h1>Train Stronger,<br>Live Healthier</h1>

<p>Build healthy habits and stay consistent.</p>

<br>

<button class="primary" onclick="startWorkout()">
Start Workout →
</button>

</div>

<h2>Workout Plans</h2>

<div class="workout-card">
<div>
<strong>🏃 Beginner Plan</strong>
<p>4 weeks · Home/Gym</p>
</div>
<span>→</span>
</div>

<div class="workout-card">
<div>
<strong>🏋️ Strength Plan</strong>
<p>8 weeks · Gym</p>
</div>
<span>→</span>
</div>

<div class="workout-card">
<div>
<strong>⚡ HIIT Plan</strong>
<p>4 weeks · Home</p>
</div>
<span>→</span>
</div>

<div class="banner">
<h2>Track Your Progress</h2>
<p>Stay consistent and reach your fitness goals.</p>
</div>

</section>


<!-- NAVIGATION -->

<nav id="navigation" style="display:none">

<button onclick="showScreen('home')" id="nav-home">
<span>⌂</span>Home
</button>

<button onclick="showScreen('learn')" id="nav-learn">
<span>◉</span>Explore
</button>

<button onclick="showScreen('home')">
<span>⊕</span>Goals
</button>

<button onclick="showScreen('workout')" id="nav-workout">
<span>▥</span>Progress
</button>

<button onclick="showScreen('home')">
<span>○</span>Profile
</button>

</nav>

</div>


<script>

function showScreen(screen) {

document.querySelectorAll('.screen').forEach(s => {
    s.classList.remove('active');
});

document.getElementById(screen).classList.add('active');

const nav = document.getElementById('navigation');

nav.style.display = screen === 'welcome' ? 'none' : 'flex';

document.querySelectorAll('nav button').forEach(b => {
    b.classList.remove('selected');
});

const selected = document.getElementById('nav-' + screen);

if(selected) selected.classList.add('selected');

window.scrollTo(0,0);

}

function updateProgress() {

const boxes = document.querySelectorAll('.goal input');

let completed = 0;

boxes.forEach(box => {
    if(box.checked) completed++;
});

const percentage = Math.round(
    (completed / boxes.length) * 100
);

document.getElementById('percentage').innerText =
    percentage + '%';

}

function startWorkout() {
    alert('Your workout session is ready! 💪');
}

</script>

</body>
</html>
